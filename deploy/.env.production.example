# =============================================================================
# BuzzPay — .env de PRODUCAO (template)
# Copie para /var/www/buzzpay/.env, preencha os __defina__ e rode:
#   php artisan key:generate   (gera APP_KEY)
# Permissao obrigatoria: chmod 600 .env ; chown buzzpay:www-data .env
# NUNCA comite segredos reais. Os "__defina__" sao preenchidos no servidor.
#
# Templating do deploy: o substituidor (envsubst/sed) deve trocar APENAS o
# token ${DOMAIN} pelo dominio real (ex.: pay.exemplo.com). NAO expanda
# ${APP_NAME}: ele e resolvido em runtime pelo proprio Laravel (variavel
# aninhada, definida abaixo). Use uma allowlist no envsubst, ex.:
#   envsubst '${DOMAIN}' < .env.production.example > .env
# =============================================================================

# -----------------------------------------------------------------------------
# Aplicacao
# -----------------------------------------------------------------------------
APP_NAME=BuzzPay
APP_ENV=production
# Vazio de proposito: gerar no servidor com `php artisan key:generate`.
APP_KEY=
# NUNCA true em producao (vaza stack traces / variaveis de ambiente).
APP_DEBUG=false
# ${DOMAIN} preenchido no deploy (ex.: pay.exemplo.com). HTTPS obrigatorio.
# Tambem fixa o esquema https na geracao de URLs/assets (atras do Nginx/TLS).
APP_URL=https://${DOMAIN}

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Custo do bcrypt; 12 e o default seguro do Laravel.
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Logs — so warning+ em producao; escreve no canal "stack".
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# -----------------------------------------------------------------------------
# Banco de dados — PostgreSQL local (dedicado ao BuzzPay)
# DB e role criados no servidor; senha via BUZZPAY_DB_PASSWORD (nunca hardcoded).
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=buzzpay
DB_USERNAME=buzzpay
DB_PASSWORD=__defina__
# Conexao local via loopback; "prefer" mantem o default do Laravel
# (config/database.php usa env('DB_SSLMODE', 'prefer')).
DB_SSLMODE=prefer

# -----------------------------------------------------------------------------
# Sessao — driver database; cookie so por HTTPS.
# OBS: a API e autenticada por TOKEN BEARER (Sanctum personal access tokens),
# NAO por cookie de sessao. Estas chaves valem apenas para qualquer rota web /
# CSRF incidental e funcionam de fato (a tabela `sessions` e criada na migration
# create_users_table). Nao sao load-bearing para a auth da API.
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Escopo do cookie de sessao no dominio do app.
SESSION_DOMAIN=${DOMAIN}
# Exige conexao HTTPS para enviar o cookie de sessao.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# -----------------------------------------------------------------------------
# Cache / Fila / Broadcast / Filesystem
# Sem worker de filas: QUEUE_CONNECTION=sync (jobs rodam inline).
# CACHE_STORE=database usa a tabela `cache` (migration create_cache_table).
# -----------------------------------------------------------------------------
CACHE_STORE=database
# CACHE_PREFIX=
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# -----------------------------------------------------------------------------
# Sanctum — autenticacao da API por TOKEN BEARER.
# routes/api.php usa o guard `auth:sanctum`; /register e /login retornam um
# token (createToken('api')->plainTextToken) que o cliente envia como
# `Authorization: Bearer {token}`. NAO ha fluxo "stateful SPA" por cookie:
# bootstrap/app.php NAO registra statefulApi(), e config/cors.php tem
# supports_credentials=false. Por isso SANCTUM_STATEFUL_DOMAINS e inerte aqui;
# mantido apenas por completude/seguranca (nao tem efeito sem statefulApi()).
SANCTUM_STATEFUL_DOMAINS=${DOMAIN}
# Expiracao do token em minutos. 1440 = 24h (alinha com o default
# de config/sanctum.php: 60*24 e o comportamento descrito no README).
SANCTUM_TOKEN_EXPIRATION=1440

# -----------------------------------------------------------------------------
# CORS — so a propria origem chama a API (auth e bearer-token; sem credenciais).
# config/cors.php aplica isto apenas em api/* com supports_credentials=false.
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://${DOMAIN}

# -----------------------------------------------------------------------------
# Provedor de cambio (exchangerate-api.com — base EUR).
# EXCHANGE_API_KEY e obrigatorio e setado a mao no servidor.
# Chaves consumidas por config/exchange.php (provider.source/base_url/key/timeout).
# -----------------------------------------------------------------------------
EXCHANGE_RATE_SOURCE=exchangerate-api.com
EXCHANGE_PROVIDER_URL=https://v6.exchangerate-api.com/v6
EXCHANGE_API_KEY=__defina__
EXCHANGE_PROVIDER_TIMEOUT=5

# -----------------------------------------------------------------------------
# Documentacao OpenAPI (L5 Swagger)
# Em producao NAO regenerar a cada request (gerar uma vez no deploy:
#   php artisan l5-swagger:generate).
# Obs.: L5_SWAGGER_CONST_HOST e OPCIONAL e nao tem efeito neste projeto — o
# servidor OpenAPI esta fixo como rota relativa em app/OpenApi/ApiDoc.php
# (#[OA\Server(url: '/api')]). Mantido apenas por padronizacao.
# -----------------------------------------------------------------------------
L5_SWAGGER_GENERATE_ALWAYS=false
L5_SWAGGER_CONST_HOST=https://${DOMAIN}

# -----------------------------------------------------------------------------
# E-mail — log por padrao; ajuste se o BuzzPay precisar enviar e-mails reais.
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@${DOMAIN}"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Vite (front-end) — nome da app no build.
# ${APP_NAME} aqui e resolvido em runtime pelo Laravel (variavel aninhada).
# -----------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"